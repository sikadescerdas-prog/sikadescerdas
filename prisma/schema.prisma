  link_maps              String?
  is_active              Boolean                @default(true)
  created_at             DateTime               @default(now()) @db.Timestamp(6)
  updated_at             DateTime               @default(now()) @db.Timestamp(6)
  village_facility_types village_facility_types @relation(fields: [type_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_facility_type")
  villages               villages               @relation(fields: [village_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_facility_village")

  @@unique([village_id, type_id, name], map: "uq_facility")
  @@index([type_id], map: "idx_facility_type")
  @@index([village_id], map: "idx_facility_village")
}

model village_facility_categories {
  id                     BigInt                   @id @default(autoincrement())
  name                   String                   @unique @db.VarChar(100)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
