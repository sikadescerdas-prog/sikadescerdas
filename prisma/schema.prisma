generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model profiles {
  id               BigInt    @id @default(autoincrement())
  user_id          String    @unique @db.VarChar(50)
  fullname         String    @db.VarChar(100)
  phone            String?   @db.VarChar(20)
  bio              String?
  gender           String?   @db.VarChar(10)
  birth_date       DateTime? @db.Date
  avatar_url       String?
  avatar_public_id String?   @db.VarChar(255)
  province         String?   @db.VarChar(100)
  regency          String?   @db.VarChar(100)
  district         String?   @db.VarChar(100)
  village          String?   @db.VarChar(100)
  detail_address   String?
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @db.Timestamp(6)
  is_completed     Boolean   @default(false)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profile_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id              String        @id @db.VarChar(50)
  email           String        @unique @db.VarChar(100)
  username        String        @unique @db.VarChar(50)
  password_hash   String
  role            String        @default("user") @db.VarChar(20)
  is_active       Boolean       @default(true)
  last_login_at   DateTime?     @db.Timestamp(6)
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  literatures     literatures[]
  news            news[]
  profiles        profiles?
  stores          stores?

  @@index([is_active], map: "idx_users_active")
  @@index([role], map: "idx_users_role")
}

model village_structure_categories {
  id                          BigInt                        @id @default(autoincrement())
  name                        String                        @unique @db.VarChar(100)
  type                        String                        @unique @db.VarChar(30)
  level                       Int?                          @db.SmallInt
  is_active                   Boolean?                      @default(true)
  created_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  village_structure_groups    village_structure_groups[]
  village_structure_positions village_structure_positions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model village_structure_periods {
  id                 BigInt               @id @default(autoincrement())
  start_year         Int                  @db.SmallInt
  end_year           Int                  @db.SmallInt
  is_active          Boolean?             @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  village_structures village_structures[]

  @@unique([start_year, end_year])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model village_structure_positions {
  id                                  BigInt                        @id @default(autoincrement())
  category_id                         BigInt
  group_id                            BigInt?
  parent_id                           BigInt?
  name                                String                        @db.VarChar(100)
  is_multiple                         Boolean?                      @default(false)
  is_active                           Boolean?                      @default(true)
  created_at                          DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                          DateTime?                     @default(now()) @db.Timestamp(6)
  village_structure_categories        village_structure_categories  @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_position_category")
  village_structure_groups            village_structure_groups?     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_position_group")
  village_structure_positions         village_structure_positions?  @relation("village_structure_positionsTovillage_structure_positions", fields: [parent_id], references: [id], onUpdate: NoAction, map: "fk_position_parent")
  other_village_structure_positions   village_structure_positions[] @relation("village_structure_positionsTovillage_structure_positions")
  village_structures                  village_structures[]

  @@index([parent_id], map: "idx_position_parent")
  @@index([category_id], map: "idx_position_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model village_structures {
  id                          BigInt                    @id @default(autoincrement())
  village_id                  BigInt
  period_id                   BigInt
  position_id                 BigInt
  full_name                   String                    @db.VarChar(100)
  gender                      String?                   @db.VarChar(10)
  photo_url                   String?
  photo_public_id             String?                   @db.VarChar(255)
  phone                       String?                   @db.VarChar(20)
  email                       String?                   @db.VarChar(100)
  address                     String?
  is_active                   Boolean?                  @default(true)
  created_at                  DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                 @default(now()) @db.Timestamp(6)
  village_structure_periods   village_structure_periods @relation(fields: [period_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_structure_period")
  village_structure_positions village_structure_positions @relation(fields: [position_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_structure_position")
  villages                    villages                  @relation(fields: [village_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_structure_village")

  @@unique([village_id, period_id, position_id, full_name], map: "uq_structure_member")
  @@index([period_id], map: "idx_structure_period")
  @@index([position_id], map: "idx_structure_position")
  @@index([village_id], map: "idx_structure_village")
}

model villages {
  id                  BigInt                @id @default(autoincrement())
  name                String?               @db.VarChar(150)
  history             String?
  vision              String?
  mission             String?
  welcome_message     String?
  logo_url            String?
  logo_public_id      String?               @db.VarChar(255)
  email               String?               @db.VarChar(100)
  phone               String?               @db.VarChar(20)
  website             String?               @db.VarChar(255)
  facebook            String?               @db.VarChar(255)
  instagram           String?               @db.VarChar(255)
  tiktok              String?               @db.VarChar(255)
  youtube             String?               @db.VarChar(255)
  address             String?
  rt                  String?               @db.VarChar(5)
  rw                  String?               @db.VarChar(5)
  province            String?               @db.VarChar(100)
  regency             String?               @db.VarChar(100)
  district            String?               @db.VarChar(100)
  village             String?               @db.VarChar(100)
  postal_code         String?               @db.VarChar(10)
  area_size           Decimal?              @db.Decimal(10, 4)
  founded_year        Int?                  @db.SmallInt
  map_embed           String?
  north_boundary      String?               @db.VarChar(255)
  south_boundary      String?               @db.VarChar(255)
  east_boundary       String?               @db.VarChar(255)
  west_boundary       String?               @db.VarChar(255)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  total_hamlets       Int                   @default(0)
  total_rw            Int                   @default(0)
  total_rt            Int                   @default(0)
  news                news[]
  village_facilities  village_facilities[]
  village_populations village_populations[]
  village_potentials  village_potentials[]
  village_structures  village_structures[]
}

model village_structure_groups {
  id                           BigInt                       @id @default(autoincrement())
  category_id                  BigInt
  name                         String                       @db.VarChar(100)
  is_active                    Boolean?                     @default(true)
  created_at                   DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?                    @default(now()) @db.Timestamp(6)
  village_structure_categories village_structure_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_structure_group_category")
